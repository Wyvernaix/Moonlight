{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Moonlight: Build complete (Debug)",
      "type": "process",
      "command": "python",
      "args": [
        "python/build.py",
        "--configuration",
        "debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Moonlight: Build complete (Release)",
      "type": "process",
      "command": "python",
      "args": [
        "python/build.py",
        "--configuration",
        "release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Moonlight: Native Debug",
      "type": "shell",
      "command": "cmake --preset debug && cmake --build --preset debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Moonlight: Test Native",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "debug",
        "--output-on-failure"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Moonlight: Test Rust",
      "type": "process",
      "command": "cargo",
      "args": [
        "test",
        "--workspace",
        "--locked"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Moonlight: Test Managed",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "Moonlight.sln",
        "--configuration",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Moonlight: Validate Modules",
      "type": "process",
      "command": "cargo",
      "args": [
        "run",
        "--locked",
        "-p",
        "module-graph",
        "--",
        "validate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
