{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_POSITION_INDEPENDENT_CODE": "ON",
        "MOONLIGHT_BUILD_TESTS": "ON",
        "MOONLIGHT_ENABLE_WARNINGS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "description": "Development build with symbols and strict diagnostics",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "description": "Optimized production-style build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "workbench",
      "inherits": "debug",
      "displayName": "Workbench Debug",
      "description": "Debug build with the SDL3/Vulkan Dear ImGui Workbench host",
      "cacheVariables": {
        "MOONLIGHT_BUILD_WORKBENCH": "ON",
        "MOONLIGHT_ENABLE_VULKAN": "ON"
      }
    },
    {
      "name": "workbench-vcpkg",
      "inherits": "debug-vcpkg",
      "displayName": "Workbench Debug with portable dependencies",
      "description": "Vulkan Workbench using the repository-local vcpkg manifest",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/third_party/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "MOONLIGHT_BUILD_WORKBENCH": "ON",
        "MOONLIGHT_ENABLE_VULKAN": "ON",
        "VCPKG_MANIFEST_FEATURES": "shader-toolchain"
      }
    },
    {
      "name": "debug-vcpkg",
      "inherits": "debug",
      "displayName": "Debug with portable dependencies",
      "description": "Debug build using the repository vcpkg manifest",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "MOONLIGHT_USE_VCPKG_DEPENDENCIES": "ON"
      }
    },
    {
      "name": "release-vcpkg",
      "inherits": "release",
      "displayName": "Release with portable dependencies",
      "description": "Release build using the repository vcpkg manifest",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "MOONLIGHT_USE_VCPKG_DEPENDENCIES": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 0
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 0
    },
    {
      "name": "workbench",
      "configurePreset": "workbench",
      "jobs": 0
    },
    {
      "name": "workbench-vcpkg",
      "configurePreset": "workbench-vcpkg",
      "jobs": 0
    },
    {
      "name": "debug-vcpkg",
      "configurePreset": "debug-vcpkg",
      "jobs": 0
    },
    {
      "name": "release-vcpkg",
      "configurePreset": "release-vcpkg",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-vcpkg",
      "configurePreset": "debug-vcpkg",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-vcpkg",
      "configurePreset": "release-vcpkg",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
