{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonlight.engine/schemas/module/module-manifest.schema.json",
  "title": "Moonlight module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "languages",
    "dependencies",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "description": { "type": "string" },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["cpp", "rust"] }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["required", "optional"] },
          "version": { "type": "string" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "cmakeTarget": { "type": "string" },
    "cargoPackage": { "type": "string" },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["linux", "macos", "windows", "headless"] }
    }
  }
}
